---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { memories } from '../data/memories';
import { SITE_TITLE } from '../consts';

const pageTitle = `Memories | ${SITE_TITLE}`;
const pageDescription =
	"A bento-style collection of video memories — moments worth revisiting.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			.memories-page {
				width: calc(100% - 2em);
				max-width: 1120px;
				margin: 0 auto;
				padding-bottom: 2em;
			}

			.memories-page h1 {
				margin-bottom: 0.2em;
			}

			.memories-intro {
				color: rgb(var(--text-muted));
				font-size: 1rem;
				max-width: 42ch;
				margin: 0 0 2em;
				line-height: 1.6;
			}

			.bento {
				display: grid;
				grid-template-columns: repeat(12, 1fr);
				gap: 1rem;
				grid-auto-flow: dense;
			}

			.bento-card {
				display: flex;
				flex-direction: column;
				background: var(--bg-elevated);
				border: 1px solid rgb(var(--border));
				border-radius: var(--radius-lg);
				overflow: hidden;
				box-shadow: var(--box-shadow);
				min-height: 0;
				transition:
					border-color 0.2s ease,
					box-shadow 0.2s ease;
			}

			.bento-card:hover {
				border-color: rgba(88, 166, 255, 0.45);
				box-shadow:
					0 8px 24px rgba(0, 0, 0, 0.35),
					0 0 0 1px rgba(88, 166, 255, 0.12);
			}

			.bento-card header {
				padding: 0.65em 1em;
				font-size: 0.85rem;
				font-weight: 600;
				color: rgb(var(--text));
				border-bottom: 1px solid rgb(var(--border));
				flex-shrink: 0;
			}

			.embed-wrap {
				position: relative;
				flex: 1;
				min-height: 0;
				background: #0d1117;
			}

			.embed-wrap iframe {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				border: 0;
			}

			/* 12-column bento spans */
			.size-hero {
				grid-column: span 8;
				grid-row: span 2;
				min-height: min(52vw, 420px);
			}

			.size-wide {
				grid-column: span 8;
				grid-row: span 1;
				min-height: min(36vw, 280px);
			}

			.size-tall {
				grid-column: span 4;
				grid-row: span 2;
				min-height: min(52vw, 420px);
			}

			.size-medium {
				grid-column: span 4;
				grid-row: span 1;
				min-height: min(28vw, 220px);
			}

			@media (max-width: 900px) {
				.bento {
					grid-template-columns: repeat(6, 1fr);
				}

				.size-hero {
					grid-column: span 6;
					grid-row: span 2;
					min-height: 52vw;
				}

				.size-wide {
					grid-column: span 6;
					min-height: 48vw;
				}

				.size-tall {
					grid-column: span 3;
					grid-row: span 2;
					min-height: 56vw;
				}

				.size-medium {
					grid-column: span 3;
					min-height: 40vw;
				}
			}

			@media (max-width: 560px) {
				.bento {
					grid-template-columns: 1fr;
				}

				.size-hero,
				.size-wide,
				.size-tall,
				.size-medium {
					grid-column: 1 / -1;
					grid-row: auto;
					min-height: 56vw;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="memories-page">
			<h1>A Trip Down Memory Lane</h1>
			<p class="memories-intro">Clips and milestones worth revisiting.</p>
			<div class="bento" role="list">
				{
					memories.map((clip) => (
						<article
							class:list={['bento-card', `size-${clip.size}`]}
							role="listitem"
						>
							<header>{clip.title}</header>
							<div class="embed-wrap">
								<iframe
									src={`https://www.youtube-nocookie.com/embed/${clip.youtubeId}?rel=0`}
									title={clip.title}
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
								/>
							</div>
						</article>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
