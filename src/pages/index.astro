---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { projects } from '../data/projects';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import ProfileImage from '../assets/profile.webp';

// Sort by date descending (latest first)
const sortedProjects = [...projects].sort((a, b) => {
	const parseDate = (d: string) => {
		const [q, y] = d.split(' ');
		const qNum = parseInt(q.replace('Q', ''), 10);
		return parseInt(y, 10) * 4 + (4 - qNum);
	};
	return parseDate(b.date) - parseDate(a.date);
});

const markerColors = ['#f97316', '#38bdf8', '#22c55e', '#a855f7', '#ec4899'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-section {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.25em;
				margin-bottom: 2em;
			}

			.hero-text {
				min-width: 0;
				text-align: center;
			}

			.typewriter {
				min-height: 1lh;
				width: fit-content;
				margin-left: auto;
				margin-right: auto;
			}

			h1.typewriter {
				white-space: nowrap;
			}

			.typewriter.typing::after {
				content: '';
				display: inline-block;
				width: 2px;
				height: 1em;
				background: currentColor;
				vertical-align: text-bottom;
				margin-left: 1px;
				animation: blink-caret 0.6s step-end infinite;
			}

			@keyframes blink-caret {
				50% { opacity: 0; }
			}

			.hero-image {
				flex-shrink: 0;
				background: none;
			}

			.hero-image img {
				width: 180px;
				height: 180px;
				object-fit: cover;
				border-radius: 50%;
				background: none;
			}

			@media (max-width: 480px) {
				.hero-section {
					flex-direction: column-reverse;
					align-items: center;
					text-align: center;
					gap: 1.25em;
				}

				.hero-image img {
					width: 150px;
					height: 150px;
				}
			}

			@media (max-width: 360px) {
				.hero-image img {
					width: 130px;
					height: 130px;
					border-radius: 50%
				}
			}

			.projects-section {
				margin-top: 3em;
			}
			.projects-section h2 {
				margin-bottom: 1.5em;
				text-align: center;
			}

			.timeline {
				position: relative;
				max-width: 900px;
				margin: 0 auto;
				padding: 0 1em;
			}

			.timeline-line {
				position: absolute;
				left: 50%;
				top: 0;
				bottom: 0;
				width: 2px;
				transform: translateX(-50%);
				background: repeating-linear-gradient(
					to bottom,
					rgb(var(--border)) 0,
					rgb(var(--border)) 4px,
					transparent 4px,
					transparent 12px
				);
				pointer-events: none;
			}

			.timeline-items {
				position: relative;
				z-index: 1;
			}

			.timeline-item {
				position: relative;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;
				gap: 1.5em;
				min-height: 100px;
				margin-bottom: 2em;
			}

			.timeline-item:last-child {
				margin-bottom: 0;
			}

			.timeline-marker {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 48px;
				height: 48px;
				min-width: 48px;
				border-radius: 50%;
				background: var(--marker-color, var(--accent));
				box-shadow: 0 0 0 4px var(--bg);
				opacity: 0.6;
				transition: opacity 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
				flex-shrink: 0;
			}

			.timeline-marker svg {
				width: 22px;
				height: 22px;
				color: white;
			}

			.timeline-marker--with-image {
				background: white;
			}

			.project-avatar {
				width: 95%;
				height: 95%;
				object-fit: cover;
				border-radius: 50%;
			}

			.timeline-marker-fallback {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 100%;
				height: 100%;
			}

			.timeline-item:hover .timeline-marker {
				opacity: 1;
				transform: scale(1.1);
				box-shadow: 0 0 0 4px var(--bg), 0 4px 16px rgba(0, 0, 0, 0.3);
			}

			.timeline-card {
				position: relative;
				min-height: 60px;
				min-width: 0;
				padding: 0.5em 1.5em;
				display: flex;
				flex-direction: column;
				justify-content: center;
				overflow: visible;
				background: transparent;
				transition: background 0.25s ease;
			}

			.timeline-item:hover .timeline-card {
				background: var(--bg-elevated);
			}

			.timeline-item[data-side="left"] .timeline-card {
				grid-column: 1;
				grid-row: 1;
				text-align: right;
			}

			.timeline-item[data-side="left"]:hover .timeline-card {
				text-align: left;
			}

			.timeline-item[data-side="left"] .card-title {
				justify-content: flex-end;
			}

			.timeline-item[data-side="left"]:hover .card-title {
				justify-content: flex-start;
			}

			.timeline-item[data-side="right"] .timeline-card {
				grid-column: 3;
				grid-row: 1;
			}

			.timeline-item[data-side="left"] .timeline-marker {
				grid-column: 2;
				grid-row: 1;
			}

			.timeline-item[data-side="right"] .timeline-marker {
				grid-column: 2;
				grid-row: 1;
			}

			.card-title {
				font-size: 1.1em;
				font-weight: 600;
				margin: 0;
				opacity: 0.6;
				transition: opacity 0.25s ease;
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.25em;
				overflow-wrap: break-word;
				word-break: break-word;
			}

			.timeline-item:hover .card-title {
				opacity: 1;
			}

			.card-details {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				margin-top: 0;
				padding: 0.25em 1.5em 1em;
				z-index: 10;
				max-height: 200px;
				overflow: hidden;
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
				transition: opacity 0.25s ease, visibility 0.25s ease;
			}

			.timeline-item:hover .card-details {
				opacity: 1;
				visibility: visible;
				pointer-events: auto;
				background: var(--bg-elevated);
			}

			.card-date {
				font-size: 0.8em;
				font-weight: 400;
				color: rgb(var(--text-muted));
				margin: 0;
				display: none;
				white-space: nowrap;
			}

			.timeline-item:hover .card-date {
				display: inline;
			}

			.card-description {
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 3;
				overflow: hidden;
				font-size: 0.9em;
				line-height: 1.3;
				color: rgb(var(--text-muted));
				margin: 0 0 0.75em;
			}

			.card-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 1em;
				font-size: 0.85em;
				margin-bottom: 0.5em;
			}

			.card-meta a {
				color: var(--accent);
			}

			.card-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				overflow: hidden;
				max-height: 2.5em;
			}

			.card-tag {
				padding: 0.2em 0.5em;
				font-size: 0.75em;
				background: var(--accent-muted);
				border-radius: 4px;
				color: var(--accent);
			}

			@media (max-width: 900px) {
				main.home-main {
					max-width: calc(100% - 2em);
				}

				.timeline {
					padding: 0;
				}

				.timeline-item {
					display: flex;
					align-items: center;
					gap: 0;
					margin-bottom: 1.5em;
				}

				.timeline-line {
					left: 16px;
					transform: none;
				}

				.timeline-marker {
					width: 32px;
					height: 32px;
					min-width: 32px;
					flex-shrink: 0;
				}

				.timeline-marker svg {
					width: 16px;
					height: 16px;
				}

				.timeline-card {
					flex: 1;
					min-width: 0;
					padding: 0.5em 0 0.5em 1.5em;
				}

				.timeline-item[data-side="left"] .timeline-card,
				.timeline-item[data-side="right"] .timeline-card {
					grid-column: unset;
					text-align: left;
				}

				.timeline-item[data-side="left"] .card-title,
				.timeline-item[data-side="left"]:hover .card-title {
					justify-content: flex-start;
				}
			}

			main.home-main {
				width: 100%;
				max-width: min(960px, calc(100% - 2em));
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home-main">
			<section class="hero-section">
				<div class="hero-text">
					<h1 class="typewriter" data-typewriter="Hi, I am Oscar Chen"></h1>
					<p class="typewriter" data-typewriter="I'm a software engineer" data-roles='["a programming nerd", "an engineer by day, raiser of little humans by night", "a clumsy DIY&apos;er", "my wife&apos;s favourite handyman", "an okish snowboarder", "a very out-of-breath runner", "a professional 3D printing enthusiast", "an AI-assisted brain-atrophied human", "a professional diver into deep rabbit holes", "essentially a Jedi but with a ping pong paddle instead of light saber", "almost a professional kickboxer with undefeated records against every sandbag in the gym"]'></p>
				</div>
				<div class="hero-image">
					<img src={ProfileImage.src} alt="Oscar Chen" width={140} height={140} />
				</div>
			</section>

			{projects.length > 0 && (
				<section class="projects-section">
					<h2>Projects</h2>
					<div class="timeline">
						<div class="timeline-line" aria-hidden="true"></div>
						<div class="timeline-items">
							{sortedProjects.map((project, index) => {
								const side = index % 2 === 0 ? 'right' : 'left';
								const markerColor = markerColors[index % markerColors.length];
								return (
									<div
										class="timeline-item"
										data-side={side}
										style={`--marker-color: ${markerColor}`}
									>
										<div class={`timeline-marker ${project.image ? 'timeline-marker--with-image' : ''}`} aria-hidden="true">
											{project.image && (
												<img
													src={project.image}
													alt={project.name}
													class="project-avatar"
													onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
												/>
											)}
											<div
												class="timeline-marker-fallback"
												style={project.image ? "display: none" : undefined}
											>
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
													<path d="M2 10h20" />
												</svg>
											</div>
										</div>
										<article class="timeline-card">
											<h3 class="card-title">
												{project.name}
												<span class="card-date">[{project.date}]</span>
											</h3>
											<div class="card-details">
												<p class="card-description">{project.description}</p>
												{(project.url || project.repo) && (
													<div class="card-meta">
														{project.url && (
															<a href={project.url} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">
																View project →
															</a>
														)}
														{project.repo && (
															<a href={project.repo} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">
																Source code →
															</a>
														)}
													</div>
												)}
												{project.tags && project.tags.length > 0 && (
													<div class="card-tags">
														{project.tags.map((tag) => (
															<span class="card-tag">{tag}</span>
														))}
													</div>
												)}
											</div>
										</article>
									</div>
								);
							})}
						</div>
					</div>
				</section>
			)}
		</main>
		<Footer />
		<script>
			const delay = (ms: number) => new Promise((r) => setTimeout(r, ms));

			function typewrite(el: HTMLElement, text: string, speed = 55): Promise<void> {
				return new Promise((resolve) => {
					el.classList.add('typing');
					let i = el.textContent!.length;
					const tick = () => {
						el.textContent = text.slice(0, ++i);
						if (i < text.length) {
							setTimeout(tick, speed);
						} else {
							el.classList.remove('typing');
							resolve();
						}
					};
					tick();
				});
			}

			function backspace(el: HTMLElement, stopAt: number, speed = 20): Promise<void> {
				return new Promise((resolve) => {
					el.classList.add('typing');
					const tick = () => {
						const current = el.textContent!;
						if (current.length > stopAt) {
							el.textContent = current.slice(0, -1);
							setTimeout(tick, speed);
						} else {
							el.classList.remove('typing');
							resolve();
						}
					};
					tick();
				});
			}

			const container = document.querySelector<HTMLElement>('.hero-text')!;
			const elements = document.querySelectorAll<HTMLElement>('[data-typewriter]');
			const roleEl = document.querySelector<HTMLElement>('[data-roles]')!;
			const roles: string[] = JSON.parse(roleEl.dataset.roles!);
			const prefix = "I'm ";
			const allTexts = [roleEl.dataset.typewriter!, ...roles.map((r) => prefix + r)];

			elements.forEach((el) => (el.textContent = el.dataset.typewriter!));
			const longestRole = allTexts.reduce((a, b) => (a.length > b.length ? a : b), '');
			roleEl.textContent = longestRole;
			const fullWidth = container.offsetWidth;
			elements.forEach((el) => (el.textContent = ''));
			container.style.width = `${fullWidth}px`;

			(async () => {
				for (const el of elements) {
					await typewrite(el, el.dataset.typewriter!, 55);
					await delay(200);
				}

				await delay(1000);

				let i = 0;
				while (true) {
					await backspace(roleEl, prefix.length);
					await delay(200);
					await typewrite(roleEl, prefix + roles[i], 56);
					await delay(1000);
					i = (i + 1) % roles.length;
				}
			})();
		</script>
	</body>
</html>
